# Shared keys consumed by docker-compose.yml. Copy to .env to override defaults.

# PostgreSQL superuser created by the `postgres` service.
POSTGRES_USER=app
POSTGRES_PASSWORD=app_secret
POSTGRES_DB=app

# Host ports the services bind to.
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Base URL the browser uses to reach the backend API (baked into the bundle).
NEXT_PUBLIC_API_URL=http://localhost:8080

# Image repository/tag, used by compose and the publish workflow.
IMAGE_REPO=local
IMAGE_TAG=dev
