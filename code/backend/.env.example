# PostgreSQL connection string. The runtime injects this; never assemble a DSN
# from separate DB_* parts.
DATABASE_URL=postgres://app:app_secret@localhost:5432/app?sslmode=disable

# Port the API listens on. Falls back to APP_PORT, then 8080.
PORT=8080

# Legacy fallback port, read only when PORT is unset.
APP_PORT=8080
